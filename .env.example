# FalkorDB (docker compose up -d)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FalkorDB Cloud only (leave empty for local Docker)
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
GRAPH_NAME=ArgusCloud
USE_MOCK_FALLBACK=false

# LLM (Groq or xAI) — powers the Copilot
LLM_API_KEY=
# Optional: leave blank to auto-pick a model from /models
LLM_MODEL=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Replay cached LLM answers only (for an offline stage demo)
LLM_STAGE_MODE=false
